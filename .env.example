# Copy to .env (which is gitignored) or export these in your shell.
# Never commit the real values.

# Required for voice. Get one at console.anthropic.com → API Keys.
# A Claude Code OAuth token (sk-ant-oat…) technically authenticates but shares
# its rate limit with your other Claude usage and expires on its own schedule —
# use a real sk-ant-api… key.
ANTHROPIC_API_KEY=sk-ant-api-your-key-here

# Optional. Defaults to claude-sonnet-5.
# claude-haiku-4-5 is faster and cheaper if replies feel slow.
JARVIS_MODEL=claude-sonnet-5

# Optional. Scripted offline replies — no API calls, no key needed.
# JARVIS_MOCK=1

# Optional. Defaults to 8787. Bound to 127.0.0.1 only.
# JARVIS_PORT=8787
